# Technology-independent synthesis used to size and partition the physical
# control region before selecting the final pinned SKY130 cell set.
read_verilog v2/rtl/quadrature_generator.v
read_verilog v2/rtl/physical_control_core.v
hierarchy -check -top v2_physical_control_core
synth -top v2_physical_control_core
check
tee -o build/v2/control_synthesis/generic_stats.json stat -json
write_verilog -noattr build/v2/control_synthesis/generic_netlist.v
write_json build/v2/control_synthesis/generic_netlist.json
